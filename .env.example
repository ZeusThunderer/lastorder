# Example variable names for local tools and compose. No secrets here: the real .env stays
# out of git. Provider keys are read by LiteLLM from the provider's own variable, e.g.
# OPENROUTER_API_KEY — never duplicate them into LLM_* names.

# Base LLM (legacy single-model config; tiers below override it)
LLM_MODEL=openrouter/xiaomi/mimo-v2.6-flash
LLM_API_BASE=
LLM_REASONING_OFF=1
LLM_TIMEOUT_S=30
LLM_MAX_TOKENS=600
LLM_TEMPERATURE=0.8

# Tiers (ADR-023): node = step and chatter, smart = reflection, will, network consolidation.
# Same suffixes as the base: _API_BASE, _REASONING_OFF, _MAX_TOKENS, _TEMPERATURE, _TIMEOUT_S.
LLM_NODE_MODEL=openrouter/qwen/qwen3.7-flash
LLM_NODE_REASONING_OFF=1
LLM_NODE_TIMEOUT_S=30
LLM_NODE_MAX_TOKENS=600
LLM_NODE_TEMPERATURE=0.8

LLM_SMART_MODEL=openrouter/z-ai/glm-5.3-flash
LLM_SMART_REASONING_OFF=1
LLM_SMART_TIMEOUT_S=60
LLM_SMART_MAX_TOKENS=2000
LLM_SMART_TEMPERATURE=0.8

# T-024 harness spike. OPENROUTER_API_KEY is the provider's own variable (see above). ZCODE_API_KEY
# is a GLM Coding Plan key (<id>.<secret>) from the Z.ai console; the spike passes it into the
# zcode harness container as ZAI_API_KEY, and the zcode-harness entrypoint renders it into the
# personal provider on the zai-api template (~/.zcode/v2/provider_config.json, tmpfs, 0600).
# ZCODE_MODEL: GLM-5.3-Flash (the compose default) or GLM-5.3. No values live in this file.
ZCODE_API_KEY=
ZCODE_MODEL=
SPIKE_MODEL=openrouter/qwen/qwen3.7-flash
SPIKE_MINUTES=15

# T-026 llm-gateway (LiteLLM proxy, ADR-033). OPENROUTER_API_KEY above is the provider key — only
# the gateway container sees it. GATEWAY_MASTER_KEY administers virtual keys (dev/gateway_keys.py);
# without it the proxy refuses to start at all (verified: fail-closed). Each consumer gets its own
# key with its own rpm and $/h ceilings: a slot harness (node-1, T-027), Last Order (hive) and the
# mind of a slot (cloud Jev). Issue with dev/gateway_keys.py and paste the printed token here —
# values live in .env only, never in git.
GATEWAY_MASTER_KEY=
# Postgres password of the gateway DB. It is interpolated into DATABASE_URL as-is: compose has
# no url-encoding, so keep it to letters and digits — @ : / # ? in it break the DB connection.
GATEWAY_DB_PASSWORD=
GATEWAY_KEY_NODE_1=
GATEWAY_KEY_HIVE=
GATEWAY_KEY_MIND_1=

# Player commands to the server (ADR-043, T-053). The deny lists ride in every
# stand: comma/space separated command names, case-insensitive, plugin prefixes
# count (/authme:login matches login). The login/password commands are ALWAYS
# denied to the agent — mind-N logs into the server itself when
# MC_LOGIN_PASSWORD_N is set for that slot; the password lives in .env only,
# reaches that slot's mind container alone and is masked out of every log.
# docker/ and docs/agents/docker-topology.md have the full recipe.
MC_COMMANDS_DENY=
MC_COMMANDS_DENY_1=
MC_COMMANDS_DENY_2=
MC_COMMANDS_DENY_3=
MC_LOGIN_PASSWORD_1=
MC_LOGIN_PASSWORD_2=
MC_LOGIN_PASSWORD_3=

# Moving a slot's body to another server (T-052, T-057): host[:port], the compose
# default is the stand's own mc-server. Durable moves live here; the infra bridge's
# slot_server action is a live override that a later full `up` can revert.
MC_SERVER_1=
MC_SERVER_2=
MC_SERVER_3=

# The infra bridge executor's key (T-057, ADR-044): HIVE_INFRA_KEY opens ONLY the
# /board/infra/* routes of hive for the host-side dev/infra_bridge.py. It must differ
# from every other key on the stand (hive refuses to start otherwise) and reaches no
# sandbox — generate like the operator key, e.g. secrets.token_urlsafe(24).
HIVE_INFRA_KEY=
