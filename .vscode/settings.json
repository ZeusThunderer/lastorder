{
  // unionclef/ and NetTyan/ are read-only references: keep the Java extension from importing
  // their Gradle projects (it rewrites unionclef/.settings and makes the submodule dirty).
  "java.import.exclusions": [
    "**/node_modules/**",
    "**/.metadata/**",
    "**/archetype-resources/**",
    "**/META-INF/maven/**",
    "**/unionclef/**",
    "**/NetTyan/**"
  ]
}
