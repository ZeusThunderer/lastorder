{
  // unionclef/ and NetTyan/ are local clones of other repositories (git-ignored here): keep the
  // Java extension from importing their Gradle projects (it rewrites unionclef/.settings).
  "java.import.exclusions": [
    "**/node_modules/**",
    "**/.metadata/**",
    "**/archetype-resources/**",
    "**/META-INF/maven/**",
    "**/unionclef/**",
    "**/NetTyan/**"
  ]
}
